{
  "manifest_version": 3,
  "name": "Proxy Switcher",
  "version": "1.1.2",
  "description": "Switch between the system proxy and a configurable HTTP-to-SOCKS5 proxy chain.",
  "permissions": ["proxy", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Switch proxy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html"
}
